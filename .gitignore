npm-debug.log*
bun-debug.log*
logs/

# ── Testing / coverage ─────────────────────────────────────
coverage/
.nyc_output/
e2e-screenshots/
.auth-state.json

# ── Hardhat / EVM ─────────────────────────────────────────
contracts-evm/artifacts/
contracts-evm/cache/
contracts-evm/ignition/deployments/
contracts-evm/typechain-types/

