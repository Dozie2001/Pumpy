# Copy this file to .env at the repository root.
# Only VITE_ values are public browser configuration. Never prefix secrets VITE_.

# Pumpy frontend
VITE_APP_NAME=Pumpy
VITE_API_URL=http://localhost:3780
VITE_SOMNIA_NETWORK=testnet
VITE_SOMNIA_RPC_URL=https://dream-rpc.somnia.network
VITE_SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
VITE_DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
VITE_DREAMDEX_MARKET_CREATOR_ADDRESS=0x5Ce69567dB39C8fBAd7e048bEfdbcCdfE67B44e6
VITE_DREAMDEX_TEST_COLLATERAL_ADDRESS=0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E
VITE_APP_URL=

# report = report-only CSP, enforce = blocking CSP, off = no CSP.
CSP_MODE=report

# Bot service configuration (server-side only)
SOMNIA_NETWORK=testnet
SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
BOT_DRY_RUN=true
MOMENTUM_MAX_PRIVATE_KEY=
REVERSAL_RITA_PRIVATE_KEY=
CROWD_FADER_PRIVATE_KEY=
DECISION_REGISTRY_ADDRESS=

# Hardhat deployment wallet (dedicated low-balance Shannon test wallet only)
HARDHAT_VAR_SHANNON_RPC_URL=https://dream-rpc.somnia.network
# 0x followed by 64 hexadecimal characters.
HARDHAT_VAR_DEPLOYER_PRIVATE_KEY=
